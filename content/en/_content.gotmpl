{{- /*
  English pages, generated by Hugo (a "content adapter").

  Dutch is the main language: content/nl holds every page with all its data
  (GPX files, numbers, links, photos, dates, draft status). translations/en only
  holds the English *text* of a page. Each English page here is:

      the Dutch page  +  its English text from translations/en (if there is one)

  A page without an English translation is shown in Dutch, with a note.
  Both folders are mounted under assets/_i18nsrc (see hugo.toml), so that
  `hugo server` rebuilds when either changes.
*/ -}}

{{- /* 1. English translations, keyed by the Dutch file they translate */ -}}
{{- $translations := dict -}}
{{- range resources.Match "_i18nsrc/en/**.md" -}}
  {{- $rel := strings.TrimPrefix "/_i18nsrc/en/" .Name -}}
  {{- $t := partial "i18n/parse.html" .Content -}}
  {{- $key := $rel -}}
  {{- with $t.fm.of }}{{ $key = replaceRE `^/?(content/)?nl/` "" . }}{{ end -}}
  {{- $translations = merge $translations (dict $key $t) -}}
{{- end -}}

{{- /* translations whose Dutch page doesn't exist */ -}}
{{- range $key, $t := $translations -}}
  {{- if not (resources.Get (printf "_i18nsrc/nl/%s" $key)) -}}
    {{- warnf "translations/en: %q is a translation of %q, which doesn't exist in content/nl" ($t.fm.title | default $key) $key -}}
  {{- end -}}
{{- end -}}

{{- /* 2. one English page per Dutch file */ -}}
{{- range resources.Match "_i18nsrc/nl/**.md" -}}
  {{- $rel := strings.TrimPrefix "/_i18nsrc/nl/" .Name -}}
  {{- $nl := partial "i18n/parse.html" .Content -}}
  {{- if not $nl.fm.url -}}{{- /* pages with a fixed url (the root 404) exist once */ -}}
    {{- $fm := $nl.fm }}{{ $body := $nl.body }}{{ $src := "nl" -}}
    {{- with index $translations $rel -}}
      {{- $fm = partial "i18n/merge.html" (dict "base" $fm "tr" .fm "where" (printf "translations/en/%s" $rel)) -}}
      {{- $body = .body }}{{ $src = "en" -}}
    {{- end -}}

    {{- $kind := "page" }}{{ $path := strings.TrimSuffix ".md" $rel -}}
    {{- if eq $rel "_index.md" }}{{ $kind = "home" }}{{ $path = "/" -}}
    {{- else if strings.HasSuffix $rel "/_index.md" }}{{ $kind = "section" }}{{ $path = strings.TrimSuffix "/_index.md" $rel }}{{ end -}}

    {{- $params := dict "source_lang" $src -}}
    {{- range $k, $v := $fm -}}
      {{- if not (in (slice "title" "date" "lastmod" "publishdate" "expirydate" "draft" "weight" "aliases" "of") (lower $k)) }}{{ $params = merge $params (dict $k $v) }}{{ end -}}
    {{- end -}}
    {{- $page := dict
        "kind" $kind
        "path" $path
        "title" ($fm.title | default "")
        "params" $params
        "content" (dict "mediaType" "text/markdown" "value" $body)
    -}}
    {{- $dates := dict -}}
    {{- with $fm.date }}{{ $dates = merge $dates (dict "date" (time.AsTime .)) }}{{ end -}}
    {{- with $fm.lastmod }}{{ $dates = merge $dates (dict "lastmod" (time.AsTime .)) }}{{ end -}}
    {{- with $dates }}{{ $page = merge $page (dict "dates" .) }}{{ end -}}
    {{- with $fm.draft }}{{ $page = merge $page (dict "draft" .) }}{{ end -}}
    {{- with $fm.weight }}{{ $page = merge $page (dict "weight" .) }}{{ end -}}
    {{- with $fm.aliases }}{{ $page = merge $page (dict "aliases" .) }}{{ end -}}
    {{- $.AddPage $page -}}
  {{- end -}}
{{- end -}}
